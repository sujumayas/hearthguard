; Engine configuration file.
config_version=5

[application]

config/name="Hearthguard"
config/version="0.2.0"
config/description="A Kingsfoil Studios hero defense set in the MatchRPG world."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.094, 0.082, 0.165, 1)
config/icon="res://assets/icon.png"

[audio]

general/default_playback_type.web=0
driver/output_latency.web=120

[autoload]

Tuning="*res://scripts/autoload/tuning.gd"
